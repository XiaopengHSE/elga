43d\u0430&nbsp;\u0431\u0430\u0437\u0435 \u0441\u0430\u043d\u0430\u0442\u043e\u0440\u0438\u0435\u0432-\u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u043e\u0440\u0438\u0435\u0432"},directionsItem3:{id:"pages.life.social-politics.directionsItem3",defaultMessage:"\u041e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u044f \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u0438\u0442\u0430\u043d\u0438\u044f \u043d\u0430&nbsp;\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u0435"},directionsItem4:{id:"pages.life.social-politics.directionsItem4",defaultMessage:"\u0414\u043e\u0431\u0440\u043e\u0432\u043e\u043b\u044c\u043d\u043e\u0435 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u043e\u0435 \u0441\u0442\u0440\u0430\u0445\u043e\u0432\u0430\u043d\u0438\u0435"},directionsItem5:{id:"pages.life.social-politics.directionsItem5",defaultMessage:"\u041f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0441\u043f\u043e\u0440\u0442\u0438\u0432\u043d\u043e-\u0440\u0430\u0437\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043c\u0435\u0440\u043e\u043f\u0440\u0438\u044f\u0442\u0438\u0439 \u0441&nbsp;\u0443\u0447\u0430\u0441\u0442\u0438\u0435\u043c \u0440\u0430\u0431\u043e\u0442\u043d\u0438\u043a\u043e\u0432 \u0438&nbsp;\u0438\u0445&nbsp;\u0441\u0435\u043c\u0435\u0439"},directionsItem6:{id:"pages.life.social-politics.directionsItem6",defaultMessage:"\u0420\u0430\u0431\u043e\u0442\u0430 \u0441 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u043c\u0438 \u0441\u043e\u044e\u0437\u0430\u043c\u0438"},text:{id:"pages.life.social-politics.text",defaultMessage:"\u0412&nbsp;\u043d\u0430\u0448\u0435\u0439 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043c\u043e\u0442\u0438\u0432\u0438\u0440\u0443\u044e\u0449\u0430\u044f \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0430, \u043f\u0440\u0435\u0434\u0443\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u044e\u0449\u0430\u044f \u0432\u044b\u043f\u043b\u0430\u0442\u0443 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0430\u043c \u043a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0442\u043d\u043e\u0439 \u0437\u0430\u0440\u0430\u0431\u043e\u0442\u043d\u043e\u0439 \u043f\u043b\u0430\u0442\u044b, \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445 \u043b\u044c\u0433\u043e\u0442 \u0438&nbsp;\u0433\u0430\u0440\u0430\u043d\u0442\u0438\u0439.<br /><br />\u041e\u0434\u043d\u043e\u0439 \u0438\u0437&nbsp;\u0433\u043b\u0430\u0432\u043d\u044b\u0445 \u0437\u0430\u0434\u0430\u0447 \u043a\u0430\u0434\u0440\u043e\u0432\u043e\u0439 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0438 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u0435 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u043a\u0432\u0430\u043b\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u0430, \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043a\u043e\u043b\u043b\u0435\u043a\u0442\u0438\u0432\u0430 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u043e\u0432, \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u044b\u0445 \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0442\u044c \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0437\u0430\u0434\u0430\u0447 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f. \u041d\u0430&nbsp;\u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e\u0439 \u043e\u0441\u043d\u043e\u0432\u0435 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435 \u0438&nbsp;\u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u043a\u0432\u0430\u043b\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u043e\u0432.<br /><br />\u041e\u0441\u043d\u043e\u0432\u043d\u0430\u044f \u0446\u0435\u043b\u044c \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0434\u0430\u043d\u043d\u043e\u0439 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0438&nbsp;&mdash; \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0435\u043d\u0438\u0435 \u043f\u0440\u0438\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f, \u0443\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u0435 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0445 \u0440\u0430\u0431\u043e\u0442\u043d\u0438\u043a\u043e\u0432 \u0434\u043b\u044f \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u043f\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u0445 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0437\u0430\u0434\u0430\u0447."}});var O=function(){var t=(0,c.Z)().formatMessage;return(0,g.jsxs)(k.Z,{children:[(0,g.jsx)(I.Z,{title:t(y.title),sectionId:"life"}),(0,g.jsx)(j.Z,{image:i(90643)}),(0,g.jsxs)(m.W2,{children:[(0,g.jsx)(C.Z,{component:"h1",sectionId:"life",children:t(y.title)}),(0,g.jsx)(x,{title:t(y.directionsTitle),items:p()(1,7).map((function(n){return t(y["directionsItem".concat(n)])}))}),(0,g.jsx)(w.Z,{children:t(y.text)})]})]})}},94441:function(t,n,i){(window.__NEXT_P=window.__NEXT_P||[]).push(["/life/social-politics",function(){return i(69385)}])}},function(t){t.O(0,[5148,7236,9462,9774,2888,179],(function(){return n=94441,t(t.s=n);var n}));var n=t.O();_N_E=n}]);
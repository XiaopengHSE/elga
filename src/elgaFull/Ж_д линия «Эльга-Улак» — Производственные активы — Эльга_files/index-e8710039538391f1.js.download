u043c\u043b\u043d \u0442\u043e\u043d\u043d \u0434\u043e\u0431\u044b\u0447\u0438 \u0432 \u0433\u043e\u0434 \u043a 2025 \u0433\u043e\u0434\u0443"},jobs2025:{id:"pages.index.jobs2025",defaultMessage:"\u0442\u044b\u0441. \u043d\u043e\u0432\u044b\u0445 \u0440\u0430\u0431\u043e\u0447\u0438\u0445 \u043c\u0435\u0441\u0442 \u043a 2025 \u0433\u043e\u0434\u0443"},text:{id:"pages.index.text",defaultMessage:"\u041a\u043e\u043c\u043f\u0430\u043d\u0438\u044f \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043e\u043c \u0430\u043a\u0442\u0438\u0432\u043e\u0432 \u043f\u043e\xa0\u0434\u043e\u0431\u044b\u0447\u0435 \u0438\xa0\u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u043a\u0435 \u0443\u0433\u043b\u044f. \u041f\u0440\u0435\u0434\u043f\u0440\u0438\u044f\u0442\u0438\u044f \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438 \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u044b \u0432\xa0\u0420\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0435 \u0421\u0430\u0445\u0430 (\u042f\u043a\u0443\u0442\u0438\u044f), \u0425\u0430\u0431\u0430\u0440\u043e\u0432\u0441\u043a\u043e\u043c \u043a\u0440\u0430\u0435.\n    <br/>\n    <br/>\n    \u042d\u043b\u044c\u0433\u0438\u043d\u0441\u043a\u0438\u0439 \u0443\u0433\u043e\u043b\u044c\u043d\u044b\u0439 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441 \u0432\xa0\u0420\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0435 \u0421\u0430\u0445\u0430 (\u042f\u043a\u0443\u0442\u0438\u044f), \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0432\xa0\u0441\u0435\u0431\u044f \u0433\u0440\u0443\u043f\u043f\u0443 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0439 \u043f\u043e\xa0\u0434\u043e\u0431\u044b\u0447\u0435, \u043e\u0431\u043e\u0433\u0430\u0449\u0435\u043d\u0438\u044e, \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u043a\u0435 \u0438\xa0\u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u0432\u044b\u0441\u043e\u043a\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u043a\u043e\u043a\u0441\u0443\u044e\u0449\u0438\u0445\u0441\u044f \u0443\u0433\u043b\u0435\u0439 \u043f\u0440\u0435\u043c\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0430 \u0441\xa0\u0430\u043d\u043e\u043c\u0430\u043b\u044c\u043d\u043e \u043d\u0438\u0437\u043a\u0438\u043c \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u0435\u043c \u0441\u0435\u0440\u044b \u0438\xa0\u0444\u043e\u0441\u0444\u043e\u0440\u0430. \u042d\u043b\u044c\u0433\u0438\u043d\u0441\u043a\u043e\u0435 \u043c\u0435\u0441\u0442\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u043c\u043e\u0436\u043d\u043e \u0441\u0440\u0430\u0432\u043d\u0438\u0442\u044c \u0441\xa0\u0442\u0430\u043a\u0438\u043c\u0438 \u0430\u0432\u0441\u0442\u0440\u0430\u043b\u0438\u0439\u0441\u043a\u0438\u043c\u0438 \u043c\u0435\u0441\u0442\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f\u043c\u0438 \u0443\u0433\u043b\u044f, \u043a\u0430\u043a \u0413\u0443\u043d\u0438\u0435\u043b\u043b\u0430, \u0413\u043e\u0440\u0434\u0441\u0442\u043e\u043d \u0438\xa0\u0413\u0440\u0435\u0433\u043e\u0440\u0438.\n    \x3c!--<br/>\n    <br/>1\n    \u0412\xa0\u0410\u043c\u0443\u0440\u0441\u043a\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u043e \u043a\u0440\u0443\u043f\u043d\u0435\u0439\u0448\u0435\u0435 \u043d\u0430\xa0\u0414\u0430\u043b\u044c\u043d\u0435\u043c \u0412\u043e\u0441\u0442\u043e\u043a\u0435 \u041e\u0433\u043e\u0434\u0436\u0438\u043d\u0441\u043a\u043e\u0435 \u043c\u0435\u0441\u0442\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435. \u041f\u043e\u0440\u0442 \xab\u0412\u0435\u0440\u0430\xbb \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0432\xa0\u041f\u0440\u0438\u043c\u043e\u0440\u0441\u043a\u043e\u043c \u043a\u0440\u0430\u0435. \u041e\u043d\xa0\u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u043f\u0435\u0440\u0435\u0432\u0430\u043b\u043a\u0443 \u0441\u044b\u0440\u044c\u044f \u0421\u0443\u0433\u043e\u0434\u0438\u043d\u0441\u043a\u043e-\u041e\u0433\u043e\u0434\u0436\u0438\u043d\u0441\u043a\u043e\u0433\u043e \u043c\u0435\u0441\u0442\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f.\n    --\x3e<br/>\n    <br/>\n    \u041f\u0440\u043e\u0435\u043a\u0442\u044b \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438 \u0432 \u0425\u0430\u0431\u0430\u0440\u043e\u0432\u0441\u043a\u043e\u043c \u043a\u0440\u0430\u0435 \u2014 \u043f\u043e\u0440\u0442 \xab\u042d\u043b\u044c\u0433\u0430\xbb \u0438 \u0422\u0438\u0445\u043e\u043e\u043a\u0435\u0430\u043d\u0441\u043a\u0430\u044f \u0436\u0435\u043b\u0435\u0437\u043d\u0430\u044f \u0434\u043e\u0440\u043e\u0433\u0430. \u041e\u043d\u0430 \u0441\u0432\u044f\u0436\u0435\u0442 \u0442\u0435\u0440\u043c\u0438\u043d\u0430\u043b \u043d\u0430 \u043f\u043e\u0431\u0435\u0440\u0435\u0436\u044c\u0435 \u041e\u0445\u043e\u0442\u0441\u043a\u043e\u0433\u043e \u043c\u043e\u0440\u044f \u0441 \u042d\u043b\u044c\u0433\u0438\u043d\u0441\u043a\u0438\u043c \u0443\u0433\u043e\u043b\u044c\u043d\u044b\u043c \u043c\u0435\u0441\u0442\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435\u043c.\n"},news:{id:"pages.index.news",defaultMessage:"\u041d\u043e\u0432\u043e\u0441\u0442\u0438"},otherAssets:{id:"pages.index.otherAssets",defaultMessage:"\u0414\u0440\u0443\u0433\u0438\u0435 \u0430\u043a\u0442\u0438\u0432\u044b \u0432 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0438"},additionalText:{id:"pages.index.additionalText",defaultMessage:"\u041a\u043e\u043c\u043f\u0430\u043d\u0438\u044f \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u0435\u0442 \u0442\u0435\u043a\u0443\u0449\u0443\u044e \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0438\xa0\u0438\u043d\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u043e\u043d\u043d\u044b\u0435 \u043f\u0440\u043e\u0435\u043a\u0442\u044b \u043a\u043e\u043c\u043f\u0430\u043d\u043
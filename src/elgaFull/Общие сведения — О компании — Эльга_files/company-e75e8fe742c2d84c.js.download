 \u043e\u0431\u043e\u0433\u0430\u0449\u0435\u043d\u0438\u044e, \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u043a\u0435 \u0438\xa0\u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u0432\u044b\u0441\u043e\u043a\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u043a\u043e\u043a\u0441\u0443\u044e\u0449\u0438\u0445\u0441\u044f \u0443\u0433\u043b\u0435\u0439 \u043f\u0440\u0435\u043c\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0430 \u0441\xa0\u0430\u043d\u043e\u043c\u0430\u043b\u044c\u043d\u043e \u043d\u0438\u0437\u043a\u0438\u043c \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u0435\u043c \u0441\u0435\u0440\u044b \u0438\xa0\u0444\u043e\u0441\u0444\u043e\u0440\u0430. \u042d\u043b\u044c\u0433\u0438\u043d\u0441\u043a\u043e\u0435 \u043c\u0435\u0441\u0442\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u043c\u043e\u0436\u043d\u043e \u0441\u0440\u0430\u0432\u043d\u0438\u0442\u044c \u0441\xa0\u0442\u0430\u043a\u0438\u043c\u0438 \u0430\u0432\u0441\u0442\u0440\u0430\u043b\u0438\u0439\u0441\u043a\u0438\u043c\u0438 \u043c\u0435\u0441\u0442\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f\u043c\u0438 \u0443\u0433\u043b\u044f, \u043a\u0430\u043a \u0413\u0443\u043d\u0438\u0435\u043b\u043b\u0430, \u0413\u043e\u0440\u0434\u0441\u0442\u043e\u043d \u0438\xa0\u0413\u0440\u0435\u0433\u043e\u0440\u0438.\n    <br/>\n    <br/>\n     \x3c!--\u0412\xa0\u0410\u043c\u0443\u0440\u0441\u043a\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u043e \u043a\u0440\u0443\u043f\u043d\u0435\u0439\u0448\u0435\u0435 \u043d\u0430\xa0\u0414\u0430\u043b\u044c\u043d\u0435\u043c \u0412\u043e\u0441\u0442\u043e\u043a\u0435 \u041e\u0433\u043e\u0434\u0436\u0438\u043d\u0441\u043a\u043e\u0435 \u043c\u0435\u0441\u0442\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435. \u041f\u043e\u0440\u0442 \xab\u0412\u0435\u0440\u0430\xbb \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0432\xa0\u041f\u0440\u0438\u043c\u043e\u0440\u0441\u043a\u043e\u043c \u043a\u0440\u0430\u0435. \u041e\u043d\xa0\u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u043f\u0435\u0440\u0435\u0432\u0430\u043b\u043a\u0443 \u0441\u044b\u0440\u044c\u044f \u0421\u0443\u0433\u043e\u0434\u0438\u043d\u0441\u043a\u043e-\u041e\u0433\u043e\u0434\u0436\u0438\u043d\u0441\u043a\u043e\u0433\u043e \u043c\u0435\u0441\u0442\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f.\n    <br/>\n    <br/>--\x3e\n    \u041f\u0440\u043e\u0435\u043a\u0442\u044b \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438 \u0432 \u0425\u0430\u0431\u0430\u0440\u043e\u0432\u0441\u043a\u043e\u043c \u043a\u0440\u0430\u0435 \u2014 \u043f\u043e\u0440\u0442 \xab\u042d\u043b\u044c\u0433\u0430\xbb \u0438 \u0422\u0438\u0445\u043e\u043e\u043a\u0435\u0430\u043d\u0441\u043a\u0430\u044f \u0436\u0435\u043b\u0435\u0437\u043d\u0430\u044f \u0434\u043e\u0440\u043e\u0433\u0430. \u041e\u043d\u0430 \u0441\u0432\u044f\u0436\u0435\u0442 \u0442\u0435\u0440\u043c\u0438\u043d\u0430\u043b \u043d\u0430 \u043f\u043e\u0431\u0435\u0440\u0435\u0436\u044c\u0435 \u041e\u0445\u043e\u0442\u0441\u043a\u043e\u0433\u043e \u043c\u043e\u0440\u044f \u0441 \u042d\u043b\u044c\u0433\u0438\u043d\u0441\u043a\u0438\u043c \u0443\u0433\u043e\u043b\u044c\u043d\u044b\u043c \u043c\u0435\u0441\u0442\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435\u043c.\n  "},text2:{id:"pages.company.index.text2",defaultMessage:"\u042d\u043b\u044c\u0433\u0438\u043d\u0441\u043a\u0438\u0439 \u0443\u0433\u043e\u043b\u044c\u043d\u044b\u0439 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441 \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442\u0441\u044f \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u043e\u0439 \u043a\u0440\u0443\u043f\u043d\u0435\u0439\u0448\u0435\u0433\u043e \u0432\xa0\u0420\u043e\u0441\u0441\u0438\u0438 \u043c\u0435\u0441\u0442\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u043a\u043e\u043a\u0441\u0443\u044e\u0449\u0435\u0433\u043e\u0441\u044f \u0443\u0433\u043b\u044f \u0441\xa0\u0437\u0430\u043f\u0430\u0441\u0430\u043c\u0438 >2,2\xa0\u043c\u043b\u0440\u0434 \u0442\u043e\u043d\u043d \u043f\u043e\xa0\u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u0430\u043c JORC. \u0412\xa02020 \u0433\u043e\u0434\u0443 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0430 \u0441\u0434\u0435\u043b\u043a\u0430 \u043f\u043e\xa0\u043f\u0440\u0438\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u044e 100% \u0432\xa0\u043a\u043e\u043c\u043f\u0430\u043d\u0438\u044f\u0445 \u042d\u0423\u041a \u0438\xa0\u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043d \u043f\u043b\u0430\u043d \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0430\u043a\u0442\u0438\u0432\u043e\u0432:"},text3:{id:"pages.company.index.text3",defaultMessage:"\u0412\xa02021 \u0433\u043e\u0434\u0443 \u043e\u0431\u044a\u0435\u043c \u0434\u043e\u0431\u044b\u0447\u0438 \u0441\u0438\u0431\u0438\u0440\u0441\u043a\u0438\u0445 \u0430\u043a\u0442\u0438\u0432\u043e\u0432 \u042d\u041b\u0421\u0418 \u0441\u043e\u0441\u0442\u0430\u0432\u0438\u043b 22,6\xa0\u043c\u043b\u043d \u0442\u043e\u043d\u043d \u0432\u044b\u0441\u043e\u043a\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u0430\u043d\u0442\u0440\u0430\u0446\u0438\u0442\u0430 Ultra High Grade \u0438\xa0\u0434\u0440\u0443\u0433\u0438\u0445 \u043c\u0435\u0442\u0430\u043b\u043b\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0443\u0433\u043b\u0435\u0439. \u041d\u0430\xa0\u043f\u0440\u0435\u0434\u043f\u0440\u0438\u044f\u0442\u0438\u044f\u0445 \u0440\u0435\u0430\u043b\u0438\u0437\u0443\u0435\u0442\u0441\u044f \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u043d\u0430\u044f \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u043f\u043e\xa0\u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u044e \u043e\u0431\u044a\u0435\u043c\u043e\u0432 \u0434\u043e\u0431\u044b\u0447\u0438 \u0438\xa0\u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u044e \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u0430.<br/><br/>\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0438\u043d\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u0439\xa0\u2014 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043d\u043e\u0432\u043e\u0439 \u0438\u043d\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u044b, \u043f\u0435\u0440\u0435\u0445\u043e\u0434 \u043d\u0430\xa0\u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0432\u044b\u0441\u043e\u043a\u043e\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u0433\u043e\u0440\u043d\u043e\u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u043d\u043e\u0433\u043e \u043e\u0431\u043e\u0440\u0443\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0435\u0434\u0438\u043d\u0438\u0447\u043d\u043e\u0439 \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u0438 \u0438\xa0\u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u044f \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u0432."},salesMarkets:{id:"pages.company.index.salesMarkets",defaultMessage:"\u0420\u044b\u043d\u043a\u0438 \u0441\u0431\u044b\u0442\u0430"},salesMarketsText:{id:"pages.company.index.salesMarketsText",defaultMessage:"\u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0432\u044b\u0441\u043e\u043a\u043e\u043c\u0443 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0443 \u043f\u0440\u043e\u0434\u0443\u043a\u0446\u0438\u044f \u042d\u043b\u044c\u0433\u0438\u043d\u0441\u043a\u043e\u0433\u043e \u0443\u0433\u043e\u043b\u044c\u043d\u043e\u0433\u043e \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u0430 \u0432\u043e\u0441\u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0430 \u043d\u0430\xa0\u043c\u0438\u0440\u043e\u0432\u043e\u043c \u0440\u044b\u043d\u043a\u0435. \u041f\u043e\u0434\u0430\u0432\u043b\u044f\u044e\u0449\u0430\u044f \u0434\u043e\u043b\u044f \u044d\u043a\u0441\u043f\u043e\u0440\u0442\u0430 \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u043d\u0430\xa0\u0441\u0442\u0440\u0430\u043d\u044b \u0410\u0437\u0438\u0430\u0442\u0441\u043a\u043e-\u0422\u0438\u0445\u043e\u043e\u043a\u0435\u0430\u043d\u0441\u043a\u043e\u0433\u043e \u0440\u0435\u0433\u0438\u043e\u043d\u0430, \u0447\u0442\u043e \u043e\u0431\u0443\u0441\u043b\u043e\u0432\u043b\u0435\u043d\u043e \u0432\u044b\u0433\u043e\u0434\u043d\u044b\u043c \u0433\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u043c \u0438\xa0\u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435\u043c \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u043b\u043e\u0433\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0438\xa0\u043f\u043e\u0440\u0442\u043e\u0432\u043e\u0439 \u0438\u043d\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u044b."},personText:{id:"pages.company.index.personText",defaultMessage:"\u041a\u043e\u043c\u0430\u043d\u0434\u0430 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438 \u043e\u0431\u043b\u0430\u0434\u0430\u0435\u0442 \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0439 \u0440\u044b\u043d\u043e\u0447\u043d\u043e\u0439 \u044d\u043a\u0441\u043f\u0435\u0440\u0442\u0438\u0437\u043e\u0439 \u0438\xa0\u043e\u043f\u044b\u0442\u043e\u043c \u0437\u0430\u043f\u0443\u0441\u043a\u0430 \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u043d\u044b\u0445 \u0443\u0433\u043e\u043b\u044c\u043d\u044b\u0445 \u043f\u0440\u043e\u0435\u043a\u0442\u043e\u0432 \u0432\xa0\u0441\u0436\u0430\u0442\u044b\u0435 \u0441\u0440\u043e\u043a\u0438."},personName:{id:"pages.company.index.personName",defaultMessage:"\u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440<br />\u0421\u0435\u0440\u0433\u0435\u0435\u0432\u0438\u0447 \u0418\u0441\u0430\u0435\u0432"},personSubtitle:{id:"pages.company.index.personSubtitle",defaultMessage:"\u0413\u0435\u043d\u0435\u0440\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440"},additionalText:{id:"pages.company.index.additionalText",defaultMessage:"<title>\u0414\u0440\u0443\u0433\u0438\u0435 \u0430\u043a\u0442\u0438\u0432\u044b \u0432 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0438</title><level2Title>\u041e\u041e\u041e\xa0\xab\u041f\u043e\u0440\u0442 \xab\u0412\u0435\u0440\u0430\xbb</level2Title>\u041e\u041e\u041e\xa0\xab\u041f\u043e\u0440\u0442 \xab\u0412\u0435\u0440\u0430\xbb \u0440\u0435\u0430\u043b\u0438\u0437\u0443\u0435\u0442 \u043f\u0440\u043e\u0435\u043a\u0442 \u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0438\xa0\u044d\u043a\u0441\u043f\u043b\u0443\u0430\u0442\u0430\u0446\u0438\u0438 \u0443\u0433\u043e\u043b\u044c\u043d\u043e\u0433\u043e \u043c\u043e\u0440\u0441\u043a\u043e\u0433\u043e \u0442\u0435\u0440\u043c\u0438\u043d\u0430\u043b\u0430 \u0432\xa0\u0440\u0430\u0439\u043e\u043d\u0435 \u043c\u044b\u0441\u0430 \u041e\u0442\u043a\u0440\u044b\u0442\u044b\u0439 \u0432\xa0\u041f\u0440\u0438\u043c\u043e\u0440\u0441\u043a\u043e\u043c \u043a\u0440\u0430\u0435.{br}{br}\u041f\u0440\u043e\u0435\u043a\u0442\xa0\u2014 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u044b\u0439, \u0432\xa0\u043d\u0435\u0433\u043e \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u044b \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432 \u0442\u0435\u0440\u043c\u0438\u043d\u0430\u043b\u0430, \u0432\xa0\u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \u0441\u043e\u043e\u0440\u0443\u0436\u0435\u043d\u0438\u0439 \u043c\u043e\u0440\u0441\u043a\u043e\u0433\u043e \u0438\xa0\u0436\u0435\u043b\u0435\u0437\u043d\u043e\u0434\u043e\u0440\u043e\u0436\u043d\u043e\u0433\u043e \u0433\u0440\u0443\u0437\u043e\u0432\u044b\u0445 \u0444\u0440\u043e\u043d\u0442\u043e\u0432, \u0441\u043a\u043b\u0430\u0434\u043e\u0432 \u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f \u0443\u0433\u043b\u044f.{br}{br}\u0422\u0435\u0440\u043c\u0438\u043d\u0430\u043b \u043e\u0441\u043d\u0430\u0449\u0435\u043d \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u043c \u043e\u0431\u043e\u0440\u0443\u0434\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u0434\u043b\u044f \u043f\u0440\u0438\u0435\u043c\u0430 \u0438\xa0\u043f\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u043a\u0438 \u0443\u0433\u043b\u044f. \u0414\u043b\u044f \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0435\u043d\u0438\u044f \u044d\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 \u043d\u0430\xa0\u043d\u0451\u043c \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u044e\u0442\u0441\u044f \u0438\u043d\u043d\u043e\u0432\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0438\xa0\u043d\u043e\u0432\u0435\u0439\u0448\u0438\u0435 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0438. \u0414\u043b\u044f \u0440\u0430\u0437\u0433\u0440\u0443\u0437\u043a\u0438 \u0443\u0433\u043b\u044f \u0437\u0430\u043f\u0443\u0449\u0435\u043d \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u043f\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u043e\u0447\u043d\u044b\u0439 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441 \u0441\xa0\u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u0432\u0430\u0433\u043e\u043d\u043e\u043e\u043f\u0440\u043e\u043a\u0438\u0434\u044b\u0432\u0430\u0442\u0435\u043b\u044f.{br}{br}\u0412 2019 \u0433\u043e\u0434\u0443 \u0432\u0432\u0435\u0434\u0435\u043d \u0432\xa0\u044d\u043a\u0441\u043f\u043b\u0443\u0430\u0442\u0430\u0446\u0438\u044e \u043f\u0435\u0440\u0432\u044b\u0439 \u044d\u0442\u0430\u043f \u043f\u0440\u043e\u0435\u043a\u0442\u0430, \u0432\xa02021 \u043f\u043b\u0430\u043d\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044c \u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432 \u0432\u0442\u043e\u0440\u043e\u0433\u043e \u044d\u0442\u0430\u043f\u0430. \u0412\xa02022 \u0433\u043e\u0434\u0443\xa0\u2014 \u043f\u043b\u0430\u043d\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0442\u044c \u0433\u0440\u0443\u0437\u043e\u043e\u0431\u043e\u0440\u043e\u0442 \u0442\u0435\u0440\u043c\u0438\u043d\u0430\u043b\u0430 \u0434\u043e\xa07\xa0\u043c\u043b\u043d \u0442\u043e\u043d\u043d, \u0432\xa0\u0434\u043e\u043b\u0433\u043e\u0441\u0440\u043e\u0447\u043d\u044b\u0445 \u043f\u043b\u0430\u043d\u0430\u0445\xa0\u2014 \u0434\u043e\xa020\xa0\u043c\u043b\u043d \u0442\u043e\u043d\u043d.{br}{br}\u041c\u0435\u0441\u0442\u043e\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0442\u0435\u0440\u043c\u0438\u043d\u0430\u043b\u0430 \u0432\u044b\u0433\u043e\u0434\u043d\u043e \u0438\u0437-\u0437\u0430 \u043a\u043b\u0438\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0443\u0441\u043b\u043e\u0432\u0438\u0439 (\u043d\u0435\u0441\u043b\u043e\u0436\u043d\u044b\u0439 \u043b\u0435\u0434\u043e\u0432\u044b\u0439 \u0440\u0435\u0436\u0438\u043c, \u043a\u0440\u0443\u0433\u043b\u043e\u0433\u043e\u0434\u0438\u0447\u043d\u0430\u044f \u043d\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u044f), \u0431\u043b\u0438\u0437\u043e\u0441\u0442\u0438 \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0436\u0435\u043b\u0435\u0437\u043d\u043e\u0434\u043e\u0440\u043e\u0436\u043d\u044b\u0445 \u043f\u0443\u0442\u0435\u0439, \u0430\xa0\u0442\u0430\u043a\u0436\u0435 \u0433\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u043a\xa0\u043e\u0441\u043d\u043e\u0432\u043d\u044b\u043c \u0440\u044b\u043d\u043a\u0430\u043c \u0441\u0431\u044b\u0442\u0430 \u0443\u0433\u043b\u044f \u0432\xa0\u0441\u0442\u0440\u0430\u043d\u0430\u0445\xa0\u0410\u0422\u0420.<level2Title>\u041e\u041e\u041e\xa0\xab\u041e\u0433\u043e\u0434\u0436\u0438\u043d\u0441\u043a\u0430\u044f \u0443\u0433\u043e\u043b\u044c\u043d\u0430\u044f \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u044f\xbb</level2Title>\u041e\u041e\u041e\xa0\xab\u041e\u0433\u043e\u0434\u0436\u0438\u043d\u0441\u043a\u0430\u044f \u0443\u0433\u043e\u043b\u044c\u043d\u0430\u044f \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u044f\xbb \u0441\xa02015 \u0433\u043e\u0434\u0430 \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442\u0441\u044f \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u043e\u0439 \u0421\u0443\u0433\u043e\u0434\u0438\u043d\u0441\u043a\u043e-\u041e\u0433\u043e\u0434\u0436\u0438\u043d\u0441\u043a\u043e\u0433\u043e \u043c\u0435\u0441\u0442\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u0432\xa0\u0410\u043c\u0443\u0440\u0441\u043a\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438. \u042d\u0442\u043e \u043a\u0440\u0443\u043f\u043d\u0435\u0439\u0448\u0435\u0435 \u043c\u0435\u0441\u0442\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0432\xa0\u0414\u0430\u043b\u044c\u043d\u0435\u0432\u043e\u0441\u0442\u043e\u0447\u043d\u043e\u043c \u0440\u0435\u0433\u0438\u043e\u043d\u0435, \u0441\u0443\u043c\u043c\u0430\u0440\u043d\u044b\u0435 \u0437\u0430\u043f\u0430\u0441\u044b \u0438\xa0\u0440\u0435\u0441\u0443\u0440\u0441\u044b \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0442 2,8\xa0\u043c\u043b\u0440\u0434 \u0442\u043e\u043d\u043d \u0443\u0433\u043b\u0435\u0439 \u043c\u0430\u0440\u043e\u043a \u0413, \u0421\u0421, \u0422\xa0\u0438\xa0\u0410.{br}{br}\u041c\u0435\u0441\u0442\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438\u043c\u0435\u0435\u0442 \u043a\u0440\u0430\u0439\u043d\u0435 \u0432\u044b\u0433\u043e\u0434\u043d\u043e\u0435 \u0433\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u043e\xa0\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044e \u043a\xa0\u0446\u0435\u043b\u0435\u0432\u044b\u043c \u0440\u044b\u043d\u043a\u0430\u043c \u0441\u0431\u044b\u0442\u0430 \u0432\xa0\u0441\u0442\u0440\u0430\u043d\u044b\xa0\u0410\u0422\u0420. \u0413\u0440\u0443\u0437\u044b \u043e\u0442\xa0\u043c\u0435\u0441\u0442\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u0438\u0440\u0443\u044e\u0442 \u0447\u0435\u0440\u0435\u0437 \u043f\u043e\u0440\u0442\u044b \u0414\u0430\u043b\u044c\u043d\u0435\u0433\u043e \u0412\u043e\u0441\u0442\u043e\u043a\u0430 (1600\xa0\u043a\u043c \u043f\u043e\xa0\u0436/\u0434), \u0432\xa0\u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \u0447\u0435\u0440\u0435\u0437 \u0443\u0433\u043e\u043b\u044c\u043d\u044b\u0439 \u0442\u0435\u0440\u043c\u0438\u043d\u0430\u043b \u041f\u043e\u0440\u0442 \xab\u0412\u0435\u0440\u0430\xbb."},chart1Title:{id:"pages.company.index.chart1Title",defaultMessage:"\u041f\u043b\u0430\u043d \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0436/\u0414 \u044d\u043b\u044c\u0433\u0430\u2013\u0443\u043b\u0430\u043a"},chart1Subtitle:{id:"pages.company.index.chart1Subtitle",defaultMessage:"\u043f\u0440\u043e\u0432\u043e\u0437\u043d\u0430\u044f, \u043c\u043b\u043d \u0442\u043e\u043d\u043d \u0432 \u0433\u043e\u0434"},chart2Title:{id:"pages.company.index.chart2Title",defaultMessage:"\u041f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u043f\u043b\u0430\u043d \u0434\u043e 2035"},booty:{id:"pages.company.index.booty",defaultMessage:"\u0434\u043e\u0431\u044b\u0447\u0430"},shipment:{id:"pages.company.index.shipment",defaultMessage:"\u043e\u0442\u0433\u0440\u044
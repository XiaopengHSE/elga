435\u0442 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u043d\u043e\u0439 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438 \u0436/\u0434 \u043b\u0438\u043d\u0438\u0438 \u042d\u043b\u044c\u0433\u0430-\u0423\u043b\u0430\u043a<br /><br />\u2022 \u041e\u0441\u0432\u043e\u0435\u043d\u0438\u0435 \u043c\u0435\u0441\u0442\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0439 \u0443\u0433\u043b\u044f \u0438&nbsp;\u0437\u043e\u043b\u043e\u0442\u0430 \u0432\u0434\u043e\u043b\u044c \u0436/\u0434 \u043b\u0438\u043d\u0438\u0438 \u042d\u043b\u044c\u0433\u0430-\u0423\u043b\u0430\u043a \u0438 &gt;1 \u043c\u043b\u0440\u0434 \u0440\u0443\u0431. \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0430\u043b \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u0434\u043e\u0445\u043e\u0434\u0430 \u042f\u043a\u0443\u0442\u0438\u0438 \u043e\u0442&nbsp;\u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u043b\u0438\u0446\u0435\u043d\u0437\u0438\u0439 \u043d\u0430&nbsp;\u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0443 \u043d\u043e\u0432\u044b\u0445 \u043c\u0435\u0441\u0442\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0439.<br /><br />\u2022 \u041f\u0440\u0438\u0442\u043e\u043a \u043d\u0430\u0441\u0435\u043b\u0435\u043d\u0438\u044f \u0432&nbsp;\u0440\u0435\u0433\u0438\u043e\u043d \u0437\u0430&nbsp;\u0441\u0447\u0435\u0442 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u043d\u043e\u0432\u044b\u0445 \u0440\u0430\u0431\u043e\u0447\u0438\u0445 \u043c\u0435\u0441\u0442 \u0438&nbsp;\u0443\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u043e\u0433\u043e HR-\u0431\u0440\u0435\u043d\u0434\u0430 \u042d\u043b\u044c\u0433\u0438\u043d\u0441\u043a\u043e\u0433\u043e \u0443\u0433\u043e\u043b\u044c\u043d\u043e\u0433\u043e \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u0430."}});t.default=function(){var n=(0,o.Z)().formatMessage;return(0,l.jsxs)(s.Z,{children:[(0,l.jsx)(p.Z,{tit
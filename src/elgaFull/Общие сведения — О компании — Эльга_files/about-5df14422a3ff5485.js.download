0438\u043c\u0430\u043b\u044c\u043d\u043e \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u0439 \u043a\u0430\u0434\u0440\u043e\u0432\u044b\u0439 \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0430\u043b \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438.<br /><br />\u041c\u044b&nbsp;\u0437\u0430\u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432\u0430\u043d\u044b \u0432&nbsp;\u043f\u0440\u0438\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0438 \u0432&nbsp;\u043a\u043e\u043c\u043f\u0430\u043d\u0438\u044e \u044d\u043d\u0435\u0440\u0433\u0438\u0447\u043d\u044b\u0445, \u0446\u0435\u043b\u0435\u0443\u0441\u0442\u0440\u0435\u043c\u043b\u0435\u043d\u043d\u044b\u0445, \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432\u044b\u0445, \u0443\u043c\u0435\u044e\u0449\u0438\u0445 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0432&nbsp;\u043a\u043e\u043c\u0430\u043d\u0434\u0435 \u043b\u044e\u0434\u0435\u0439, \u0433\u043e\u0442\u043e\u0432\u044b\u0445 \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0441\u0432\u043e\u0438 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0430, \u0437\u043d\u0430\u043d\u0438\u044f \u0438&nbsp;\u043e\u043f\u044b\u0442.<br /><br />\u041f\u0440\u0438\u0441\u043e\u0435\u0434\u0438\u043d\u0438\u0442\u044c\u0441\u044f \u043a&nbsp;\u043d\u0430\u0448\u0435\u0439 \u043a\u043e\u043c\u0430\u043d\u0434\u0435 \u043c\u043e\u0436\u043d\u043e, \u043d\u0430\u043f\u0440\u0430\u0432\u0438\u0432 \u0441\u0432\u043e\u0435 \u0440\u0435\u0437\u044e\u043c\u0435 \u043f\u043e&nbsp;\u0430\u0434\u0440\u0435\u0441\u0443 <a href="mailto:hr@elga.ru" style="text-decoration: underline">hr@elga.ru</a>.'}});t.default=function(){var n=(0,r.Z)().formatMessage;return(0,l.jsxs)(a.Z,{children:[(0,l.jsx)(p.Z,{t
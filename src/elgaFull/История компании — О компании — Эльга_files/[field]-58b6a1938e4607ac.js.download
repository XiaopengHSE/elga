4b\u0445 \u0437\u0430\u043f\u0430\u0441\u043e\u0432 \u0443\u0433\u043b\u044f"},elginKeyFacts2Title:{id:"constants.fieldData.elginKeyFacts2Title",defaultMessage:"\u0417\u0430\u043f\u0430\u0441\u044b"},elginKeyFacts2Text:{id:"constants.fieldData.elginKeyFacts2Text",defaultMessage:"\u042d\u043b\u044c\u0433\u0438\u043d\u0441\u043a\u043e\u0433\u043e \u043c\u0435\u0441\u0442\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u043f\u043e \u043e\u0446\u0435\u043d\u043a\u0435 JORC \u2014 2,2 \u043c\u043b\u0440\u0434 \u0442"},elginKeyFacts3Title:{id:"constants.fieldData.elginKeyFacts3Title",defaultMessage:"\u041e\u0441\u043d\u043e\u0432\u043d\u043e\u0439 \u043e\u0431\u044a\u0435\u043c \u0443\u0433\u043b\u0435\u0439 86%"},elginKeyFacts3Text:{id:"constants.fieldData.elginKeyFacts3Text",defaultMessage:"\u041d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0432 4-\u0445 \u043d\u0438\u0436\u043d\u0438\u0445 \u043f\u043b\u0430\u0441\u0442\u0430\u0445 \u0437\u0430\u043b\u0435\u0433\u0430\u043d\u0438\u044f: Y5 (\u0442\u043e\u043b\u0449\u0438\u043d\u0430 12-20 \u043c), Y4 (9-12 \u043c), H16 (6-12 \u043c), H15 (3-6 \u043c)"},locationTitle:{id:"constants.fieldData.locationTitle",defaultMessage:"\u0420\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435"},elginLocationText:{id:"constants.fieldData.elginLocationText",defaultMessage:"\u041b\u0438\u0446\u0435\u043d\u0437\u0438\u043e\u043d\u043d\u044b\u0439 \u0443\u0447\u0430\u0441\u0442\u043e\u043a \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d \u0432&nbsp;\u044e\u0433\u043e-\u0432\u043e\u0441\u0442\u043e\u0447\u043d\u043e\u0438\u0306 \u0447\u0430\u0441\u0442\u0438 \u042f\u043a\u0443\u0442\u0438\u0438, \u043f\u0440\u0438\u0431\u043b\u0438\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0432&nbsp;415&nbsp;\u043a\u043c \u043a&nbsp;\u044e\u0433\u043e-\u0432\u043e\u0441\u0442\u043e\u043a\u0443 \u043e\u0442&nbsp;\u0433. \u041d\u0435\u0440\u044e\u043d\u0433\u0440\u0438 \u0438&nbsp;\u0432&nbsp;300&nbsp;\u043a\u043c \u043e\u0442&nbsp;\u0411\u0430\u0439\u043a\u0430\u043b\u043e-\u0410\u043c\u0443\u0440\u0441\u043a\u043e\u0439\u0306 \u043c\u0430\u0433\u0438\u0441\u0442\u0440\u0430\u043b\u0438 (\u0411\u0410\u041c), \u0432&nbsp;\u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0438\u0306 \u0447\u0430\u0441\u0442\u0438 \u0422\u043e\u043a\u0438\u043d\u0441\u043a\u043e\u0433\u043e \u0443\u0433\u043b\u0435\u043d\u043e\u0441\u043d\u043e\u0433\u043e \u0440\u0430\u0438\u0306\u043e\u043d\u0430 \u042e\u0436\u043d\u043e- \u042f\u043a\u0443\u0442\u0441\u043a\u043e\u0433\u043e \u0443\u0433\u043e\u043b\u044c\u043d\u043e\u0433\u043e \u0431\u0430\u0441\u0441\u0435\u0438\u0306\u043d\u0430, \u043a&nbsp;\u0437\u0430\u043f\u0430\u0434\u0443 \u043e\u0442&nbsp;\u043e\u0437. \u0411\u043e\u043b\u044c\u0448\u043e\u0435 \u0422\u043e\u043a\u043e, \u0432\u0431\u043b\u0438\u0437\u0438 \u0433\u0440\u0430\u043d\u0438\u0446 \u0410\u043c\u0443\u0440\u0441\u043a\u043e\u0439\u0306 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0438&nbsp;\u0425\u0430\u0431\u0430\u0440\u043e\u0432\u0441\u043a\u043e\u0433\u043e \u043a\u0440\u0430\u044f, \u0420\u043e\u0441\u0441\u0438\u044f.<br /><br />\u0411\u043b\u0438\u0436\u0430\u0439\u0448\u0438\u0435 \u043d\u0430\u0441\u0435\u043b\u0435\u043d\u043d\u044b\u0435 \u043f\u0443\u043d\u043a\u0442\u044b \u043d\u0430&nbsp;\u0417\u0430\u043f\u0430\u0434 \u043e\u0442&nbsp;\u043f\u0440\u0435\u0434\u043f\u0440\u0438\u044f\u0442\u0438\u044f&nbsp;&mdash; \u0433. \u041d\u0435\u0440\u044e\u043d\u0433\u0440\u0438 \u0438&nbsp;\u043f\u043e\u0441. \u0427\u0443\u043b\u044c\u043c\u0430\u043d, \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u043d\u044b\u0435 \u0432&nbsp;510&nbsp;\u043a\u043c \u0432\u0434\u043e\u043b\u044c \u0437\u0438\u043c\u043d\u0435\u0438\u0306 \u0434\u043e\u0440\u043e\u0433\u0438, \u0430&nbsp;\u0442\u0430\u043a\u0436\u0435 \u043f\u043e\u0441. \u0427\u0430\u0433\u0434\u0430&nbsp;&mdash; \u0432&nbsp;350&nbsp;\u043a\u043c \u043d\u0430&nbsp;\u0421\u0435\u0432\u0435\u0440.<br /><br />\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0432\u044b\u0441\u043e\u0442\u043d\u0430\u044f \u043e\u0442\u043c\u0435\u0442\u043a\u0430 \u0440\u0430\u0438\u0306\u043e\u043d\u0430&nbsp;&mdash; \u043e\u043a\u043e\u043b\u043e 1270&nbsp;\u043c. \u041e\u0431\u0449\u0435\u0435 \u043f\u043e\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u0440\u0435\u043b\u044c\u0435\u0444\u0430 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u0441&nbsp;\u0421\u0435\u0432\u0435\u0440\u043e-\u0417\u0430\u043f\u0430\u0434\u0430 \u043d\u0430&nbsp;\u042e\u0433\u043e-\u0412\u043e\u0441\u0442\u043e\u043a, \u0441&nbsp;1300-1400&nbsp;\u043c \u0434\u043e&nbsp;1000-1100&nbsp;\u043c \u043d\u0430\u0434 \u0443\u0440\u043e\u0432\u043d\u0435\u043c \u043c\u043e\u0440\u044f"},elginDevelopmentHistory2007:{id:"constants.fieldData.elginDevelopmentHistory2007",defaultMessage:"\u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0430 \u043b\u0438\u0446\u0435\u043d\u0437\u0438\u044f \u2116\u042f\u041a\u0423 03730 \u0422\u042d \u043d\u0430 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u043d\u0435\u0434\u0440\u0430\u043c\u0438"},elginDevelopmentHistory2011:{id:"constants.fieldData.elginDevelopmentHistory2011",defaultMessage:"\u043d\u0430\u0447\u0430\u043b\u043e \u0434\u043e\u0431\u044b\u0447\u0438"},elginDevelopmentHistory2012:{id:"constants.fieldData.elginDevelopmentHistory2012",defaultMessage:"\u0437\u0430\u043f\u0443\u0441\u043a \u043e\u0431\u043e\u0433\u0430\u0442\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0444\u0430\u0431\u0440\u0438\u043a\u0438"},elginDevelopmentHistory2020:{id:"constants.fieldData.elginDevelopmentHistory2020",defaultMessage:"\u0432\u044b\u0445\u043e\u0434 \u043d\u0430 \u043e\u0431\u044a\u0435\u043c \u0434\u043e\u0431\u044b\u0447\u0438 7 \u043c\u043b\u043d \u0442/\u0433\u043e\u0434"},elginDevelopmentHistory2023:{id:"constants.fieldData.elginDevelopmentHistory2023",defaultMessage:"\u0432\u044b\u0445\u043e\u0434
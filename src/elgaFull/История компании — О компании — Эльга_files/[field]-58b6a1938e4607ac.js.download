35\u0442 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0441\u0445\u0435\u043c\u0443 \u043e\u0431\u043e\u0433\u0430\u0449\u0435\u043d\u0438\u044f\xa0\u2014 \u0432\xa0\u0442\u044f\u0436\u0435\u043b\u043e\u0439 \u0441\u0440\u0435\u0434\u0435 \u0441\xa0\u0433\u043b\u0443\u0431\u0438\u043d\u043e\u0439 \u043e\u0431\u043e\u0433\u0430\u0449\u0435\u043d\u0438\u044f 13\xa0\u043c\u043c. \u0421\u0445\u0435\u043c\u0430 \u043e\u0431\u043e\u0433\u0430\u0449\u0435\u043d\u0438\u044f \u0437\u0430\u043c\u043a\u043d\u0443\u0442\u0430 \u0447\u0435\u0440\u0435\u0437 \u043d\u0430\u0440\u0443\u0436\u043d\u044b\u0435 \u0448\u043b\u0430\u043c\u043e\u0432\u044b\u0435 \u043e\u0442\u0441\u0442\u043e\u0439\u043d\u0438\u043a\u0438.<br /><br/>\xab\u041b\u0438\u0441\u0442\u0432\u044f\u043d\u0441\u043a\u0430\u044f-2\xbb \u0432\u0432\u0435\u0434\u0435\u043d\u0430 \u0432 \u044d\u043a\u0441\u043f\u043b\u0443\u0430\u0442\u0430\u0446\u0438\u044e \u0432 2007 \u0433\u043e\u0434\u0443. \u041f\u043e\u0441\u043b\u0435 \u0441\u0435\u0440\u0438\u0438 \u043c\u043e\u0434\u0435\u0440\u043d\u0438\u0437\u0430\u0446\u0438\u0439 \u0432 2012 \u0438 2019 \u0433\u043e\u0434\u0430\u0445 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0444\u0430\u0431\u0440\u0438\u043a\u0438 \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u043b\u0430\u0441\u044c \u043d\u0430 40%. <br/>\u041d\u0430 \u0444\u0430\u0431\u0440\u0438\u043a\u0435 \u0432\u043d\u0435\u0434\u0440\u0435\u043d\u044b \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0438 \u0443\u0433\u043b\u0435\u043e\u0431\u043e\u0433\u0430\u0449\u0435\u043d\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u0442\u0432\u0435\u0447\u0430\u044e\u0442 \u043c\u0438\u0440\u043e\u0432\u044b\u043c \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u0430\u043c \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0430 \u0438 \u044d\u0